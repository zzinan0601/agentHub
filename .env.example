# 이 파일을 .env 로 복사해서 값을 채운다. 설정은 코드에 하드코딩하지 않는다. (요구사항 9)

# --- 코어 서버 ---------------------------------------------------------------
CORE_HOST=0.0.0.0
CORE_PORT=8000
LOG_LEVEL=INFO

# --- 대화/스케줄 저장소 (PostgreSQL) ------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agenthub

# --- Ollama ------------------------------------------------------------------
# 코디네이터가 쓸 LLM 주소. 내 노트북 것을 쓰려면 localhost, 공용 서버면 그 주소.
OLLAMA_BASE_URL=http://localhost:11434
# 새 채팅방의 기본 모델. 폐쇄망에서는 gemma4-12b 로 바꾼다. (요구사항 18/21)
DEFAULT_MODEL=gemma4:31b-cloud
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300

# --- num_ctx 동적 계산 (요구사항 14) ------------------------------------------
MAX_TOKENS=2048
CHARS_PER_TOKEN=2.0
NUM_CTX_MARGIN=512
NUM_CTX_MIN=2048
NUM_CTX_MAX=32768

# --- 에이전트 레지스트리 ------------------------------------------------------
REGISTRY_PATH=./registry.yaml
HEALTH_POLL_S=30
AGENT_TIMEOUT_S=300

# --- 대화 --------------------------------------------------------------------
# 라우터가 JSON 만 내도록 Ollama 에 강제한다. 작은 모델일수록 이게 있어야 한다.
ROUTER_JSON_FORMAT=true
ROUTER_RETRIES=2
# 라우터가 받은 응답을 남길 파일. 비우면 기록하지 않는다.
# 파싱이 실패하면 응답 원문이 통째로 남는다. python scripts/router_log.py 로 본다.
ROUTER_LOG_PATH=./logs/router.log

# 병렬로 2개 이상 성공했을 때 결과를 어떻게 낼지
#   off : 에이전트 이름을 제목으로 순서대로 붙인다 (LLM 호출 없음, 빠르다)
#   llm : 코디네이터 LLM 이 하나의 답변으로 정리한다 (읽기 좋지만 수십 초 더 걸린다)
REDUCE_MODE=off

# 모델을 메모리에 올려둘 시간(분). 0 이면 즉시 내리고, -1 이면 계속 올려둔다.
# 기본 5분이라 띄엄띄엄 쓰면 모델을 다시 올리는 시간을 매번 문다.
OLLAMA_KEEP_ALIVE_MIN=10

CONTEXT_TURNS=6
TIMEZONE=Asia/Seoul

# --- 로그인 (비밀번호 없음, 사내망 전용) --------------------------------------
# 이름만으로 들어간다. 보안 경계는 사내망이 맡는다. 인터넷에 노출하지 말 것.
SESSION_TTL_DAYS=30
# 쿠키를 쓰므로 "*" 를 쓸 수 없다. 개발용 Vue 서버만 열어둔다.
# 폐쇄망에서는 코어가 화면까지 서빙해 같은 출처라 CORS 자체가 필요 없다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 활용 현황 ----------------------------------------------------------------
# 이 실패율을 넘으면 '점검 대상' 에 올린다.
INSIGHT_FAIL_RATE_WARN=0.2
# 자주 묻는 질문을 묶는 기준. 0.8 이면 여덟 글자 중 여섯 자 이상 닮으면 같은 질문으로 본다.
# 바꾼 뒤에는 python scripts/test_similar.py 로 경계를 확인한다.
INSIGHT_SIMILARITY=0.8
# 묶기에 쓸 최근 질문 수. 비교가 제곱으로 늘어나므로 상한을 둔다.
INSIGHT_SAMPLE=2000

# --- 소프트 하네스 파일 위치 (요구사항 10/11) ---------------------------------
PROMPTS_DIR=./core/prompts
SKILLS_DIR=./core/skills
WORKFLOWS_DIR=./core/workflows
# 화면에서 워크플로우를 만들고 고칠 수 있게 할지 (false 면 보기 전용)
WORKFLOW_EDIT_ENABLED=true

# --- UI 빌드 결과 -------------------------------------------------------------
UI_DIST_DIR=./ui/dist
