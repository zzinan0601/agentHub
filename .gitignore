# --- 환경마다 다시 만드는 것 -------------------------------------------------
# 가상환경에는 만든 사람의 절대경로가 박혀 있어 남이 받아도 못 쓴다.
.venv/
agents/*/.venv/
__pycache__/
*.pyc

# npm ci 로 언제든 되살린다. 75MB 를 올릴 이유가 없다.
ui/node_modules/

# 빌드 결과물. npm run build 로 만든다.
# 폐쇄망에는 이 폴더를 빌드해서 함께 반입한다. (docs/OFFLINE_DEPLOY.md)
ui/dist/

# 폐쇄망 반입용으로 미리 받아 둔 파이썬 휠(13MB).
# 저장소에 넣지 않고 반입할 때 pip download 로 다시 받는다. (vendor/README.md)
vendor/

# --- 돌면서 쌓이는 것 --------------------------------------------------------
# 에이전트가 만든 첨부파일. 각자 노트북에만 있으면 된다.
agents/*/files/
# 라우터 진단 로그. 환경마다 다르게 쌓인다.
logs/

# --- 배포용으로 묶은 압축본 ---------------------------------------------------
# 반입할 때 그때그때 만든다. 저장소에 넣으면 소스와 압축본이 따로 놀고 용량만 커진다.
*.zip

# --- 도구 설정 ---------------------------------------------------------------
# Claude Code 의 개인 설정. 사람마다 다르다.
.claude/settings.local.json

# --- 편집기 / OS ------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
