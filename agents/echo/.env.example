# 이 파일을 .env 로 복사해서 값을 채운다. 설정은 코드에 하드코딩하지 않는다. (요구사항 9)

# --- 이 에이전트 자신 ---------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=9001
MANIFEST_PATH=./manifest.yaml
LOG_LEVEL=INFO

# --- 첨부파일(이미지/엑셀 등) -------------------------------------------------
AGENT_FILES_DIR=./files
AGENT_FILE_TTL_HOURS=72

# --- Ollama ------------------------------------------------------------------
# 내 노트북의 Ollama 를 쓰려면 localhost, 공용 서버를 쓰려면 그 주소로 바꾼다.
OLLAMA_BASE_URL=http://localhost:11434
# 코어가 model 을 내려주므로 보통 쓰이지 않지만, 단독 테스트용 기본값이다.
DEFAULT_MODEL=gemma4:31b-cloud
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300

# --- num_ctx 동적 계산 (요구사항 14) ------------------------------------------
MAX_TOKENS=2048
CHARS_PER_TOKEN=2.0
NUM_CTX_MARGIN=512
NUM_CTX_MIN=2048
NUM_CTX_MAX=32768
