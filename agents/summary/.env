# 이 파일을 .env 로 복사해서 값을 채운다. 설정은 코드에 하드코딩하지 않는다. (요구사항 9)

# --- 이 에이전트 자신 ---------------------------------------------------------
AGENT_HOST=0.0.0.0
AGENT_PORT=9002
MANIFEST_PATH=./manifest.yaml
LOG_LEVEL=INFO

# --- 첨부파일(이미지/엑셀 등) -------------------------------------------------
AGENT_FILES_DIR=./files
AGENT_FILE_TTL_HOURS=72

# --- Ollama ------------------------------------------------------------------
# 내 노트북의 Ollama 를 쓰려면 localhost, 공용 서버를 쓰려면 그 주소로 바꾼다.
OLLAMA_BASE_URL=http://localhost:11434
# 이 에이전트를 이 모델로 고정한다. 비워두면 화면에서 고른 모델을 그대로 쓴다.
#
# 에이전트는 각자 자기 노트북의 Ollama 를 부른다. 화면의 모델 목록은 코어의 Ollama 에서
# 오므로, 거기 있는 모델이 내 노트북에는 없을 수 있다. 그러면 나만 'model not found' 로
# 빠진다. 내 노트북에 확실히 있는 모델을 여기 적어두면 그런 일이 없다.
#   ollama list 로 확인한 이름을 그대로 적는다. 예: AGENT_MODEL=gemma4:e4b
AGENT_MODEL=gpt-oss:20b-cloud

# 코어 없이 이 에이전트만 curl 로 찔러볼 때 쓰는 값이다.
# **평소에는 쓰이지 않는다.** 코어가 화면에서 고른 모델을 매번 내려주기 때문이다.
# 여기 무엇을 적어두든 화면에서 고른 모델로 돈다. 고정하고 싶으면 위의 AGENT_MODEL 을 쓴다.
DEFAULT_MODEL=gemma4:31b-cloud
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300
OLLAMA_KEEP_ALIVE_MIN=10

# --- num_ctx 동적 계산 (요구사항 14) ------------------------------------------
MAX_TOKENS=2048
CHARS_PER_TOKEN=2.0
NUM_CTX_MARGIN=512
NUM_CTX_MIN=2048
NUM_CTX_MAX=32768
