# 이 파일을 .env 로 복사해서 값을 채운다. 설정은 코드에 하드코딩하지 않는다. (요구사항 9)

# --- 코어 서버 ---------------------------------------------------------------
CORE_HOST=0.0.0.0
CORE_PORT=8000
LOG_LEVEL=INFO

# --- 대화/스케줄 저장소 (PostgreSQL) ------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/agenthub

# --- Ollama ------------------------------------------------------------------
# 코디네이터가 쓸 LLM 주소. 내 노트북 것을 쓰려면 localhost, 공용 서버면 그 주소.
OLLAMA_BASE_URL=http://localhost:11434
# 새 채팅방의 기본 모델. 폐쇄망에서는 gemma4-12b 로 바꾼다. (요구사항 18/21)
DEFAULT_MODEL=gemma4:31b-cloud
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300

# --- num_ctx 동적 계산 (요구사항 14) ------------------------------------------
MAX_TOKENS=2048
CHARS_PER_TOKEN=2.0
NUM_CTX_MARGIN=512
NUM_CTX_MIN=2048
NUM_CTX_MAX=32768

# --- 에이전트 레지스트리 ------------------------------------------------------
REGISTRY_PATH=./registry.yaml
HEALTH_POLL_S=30
AGENT_TIMEOUT_S=300

# --- 대화 --------------------------------------------------------------------
CONTEXT_TURNS=6
TIMEZONE=Asia/Seoul

# --- 소프트 하네스 파일 위치 (요구사항 10/11) ---------------------------------
PROMPTS_DIR=./core/prompts
SKILLS_DIR=./core/skills
WORKFLOWS_DIR=./core/workflows

# --- UI 빌드 결과 -------------------------------------------------------------
UI_DIST_DIR=./ui/dist
